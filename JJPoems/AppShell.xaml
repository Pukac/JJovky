<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JJPoems.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:JJPoems.Views"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Title="JJ Poems">

    <TabBar>
        <ShellContent
            Title="Domov"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />
        <ShellContent
            Title="Inspiracia"
            ContentTemplate="{DataTemplate views:PoemsPage}"
            Route="poems" />
        <ShellContent
            Title="Tvorba"
            ContentTemplate="{DataTemplate views:StudioPage}"
            Route="studio" />
        <ShellContent
            Title="Profil"
            ContentTemplate="{DataTemplate views:ProfilePage}"
            Route="profile" />
    </TabBar>
</Shell>
