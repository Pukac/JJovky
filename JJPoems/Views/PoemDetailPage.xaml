<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="JJPoems.Views.PoemDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:JJPoems.ViewModels"
    x:DataType="viewModels:PoemDetailViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24,18,24,32" Spacing="20">
            <Border Style="{StaticResource HeroCardStyle}">
                <VerticalStackLayout Spacing="18">
                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                        <Label Text="{Binding CurrentPoem.Theme}" Style="{StaticResource TagLabelStyle}" Margin="0,0,8,8" />
                        <Label Text="{Binding CurrentPoem.Mood}" Style="{StaticResource TagLabelStyle}" Margin="0,0,8,8" />
                        <Label Text="{Binding CurrentPoem.ReadingTimeLabel}" Style="{StaticResource TagLabelStyle}" Margin="0,0,8,8" />
                    </FlexLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Citaci priestor" Style="{StaticResource OverlineLabelStyle}" />
                        <Label Text="{Binding CurrentPoem.Title}" Style="{StaticResource PageTitleLabelStyle}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource ThemeBorderDivider}" />
                    <Label Text="{Binding CurrentPoem.Content}" Style="{StaticResource PoemBodyLabelStyle}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding FavoriteButtonText}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleFavoriteCommand}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Predchadzajuca" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GoToPreviousCommand}" IsEnabled="{Binding HasPrevious}" />
                <Button Grid.Column="1" Text="Dalsia" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GoToNextCommand}" IsEnabled="{Binding HasNext}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
