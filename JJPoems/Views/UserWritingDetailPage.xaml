<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="JJPoems.Views.UserWritingDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:JJPoems.ViewModels"
    x:DataType="viewModels:UserWritingDetailViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24,18,24,32" Spacing="20">
            <Border
                Style="{StaticResource HeroCardStyle}"
                BackgroundColor="{Binding CurrentWriting.SectionSurfaceHex}"
                Stroke="{Binding CurrentWriting.SectionBorderHex}">
                <VerticalStackLayout Spacing="18">
                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                        <Border BackgroundColor="{Binding CurrentWriting.SectionTagHex}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,6" Margin="0,0,8,8">
                            <Label Text="{Binding CurrentWriting.Section}" TextColor="{Binding CurrentWriting.SectionAccentHex}" FontSize="12" FontFamily="{StaticResource SansFontSemiBold}" />
                        </Border>
                        <Label Text="{Binding CurrentWriting.Mood}" Style="{StaticResource TagLabelStyle}" Margin="0,0,8,8" />
                        <Label Text="{Binding CurrentWriting.ReadingTimeLabel}" Style="{StaticResource TagLabelStyle}" Margin="0,0,8,8" />
                        <Label Text="{Binding CurrentWriting.DisplayDate}" Style="{StaticResource TagLabelStyle}" Margin="0,0,8,8" />
                    </FlexLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tvoj citaci priestor" Style="{StaticResource OverlineLabelStyle}" />
                        <Label Text="{Binding CurrentWriting.Title}" Style="{StaticResource PageTitleLabelStyle}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource ThemeBorderDivider}" />
                    <Label Text="{Binding CurrentWriting.Content}" Style="{StaticResource PoemBodyLabelStyle}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Pokracovat v uprave" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding EditCommand}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Predchadzajuci" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GoToPreviousCommand}" IsEnabled="{Binding HasPrevious}" />
                <Button Grid.Column="1" Text="Dalsi" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GoToNextCommand}" IsEnabled="{Binding HasNext}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
