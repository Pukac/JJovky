<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <OnPlatform x:TypeArguments="x:String" x:Key="SerifFontFamily">
        <On Platform="Android" Value="serif" />
        <On Platform="iOS" Value="Times New Roman" />
        <On Platform="WinUI" Value="Georgia" />
        <On Platform="MacCatalyst" Value="Times New Roman" />
    </OnPlatform>

    <x:String x:Key="SansFontFamily">OpenSansRegular</x:String>
    <x:String x:Key="SansFontSemiBold">OpenSansSemibold</x:String>

    <RadialGradientBrush x:Key="ThemeWarmGlowBrush" Center="0.5,0.5" Radius="0.75">
        <GradientStop Color="#FFF8EE" Offset="0.0" />
        <GradientStop Color="#E9D8C3" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="ThemeAccentGlowBrush" Center="0.5,0.5" Radius="0.8">
        <GradientStop Color="#D6BC9F" Offset="0.0" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="ThemeHeroSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFDFC" Offset="0.0" />
        <GradientStop Color="#F3E7D8" Offset="1.0" />
    </LinearGradientBrush>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimaryBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ThemePrimaryBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ThemePrimaryText}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource ThemePrimaryText}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource ThemeCard}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource ThemeAccent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource ThemeAccent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource ThemeSecondaryText}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource ThemeBorderDivider}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18,15" />
        <Setter Property="FontFamily" Value="{StaticResource SansFontSemiBold}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ThemeSecondaryText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ThemeSecondaryText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
        <Setter Property="TitleColor" Value="{DynamicResource ThemeSecondaryText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ThemeSecondaryText}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource ThemeAccent}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource ThemeBorderDivider}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeCard}" />
        <Setter Property="Stroke" Value="{DynamicResource ThemeBorderDivider}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="26" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#19000000" Offset="0,10" Radius="22" Opacity="0.12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PremiumPanelStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemePanel}" />
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="26" />
        <Setter Property="Background" Value="{DynamicResource ThemeHeroSurfaceBrush}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="34" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#22000000" Offset="0,16" Radius="28" Opacity="0.18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SerifFontFamily}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="LineHeight" Value="1.12" />
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
    </Style>

    <Style x:Key="DisplayTitleLabelStyle" TargetType="Label" BasedOn="{StaticResource PageTitleLabelStyle}">
        <Setter Property="FontSize" Value="42" />
        <Setter Property="LineHeight" Value="1.05" />
    </Style>

    <Style x:Key="SectionTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SerifFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
    </Style>

    <Style x:Key="PoemTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SerifFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="HeroBodyLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeHeroBody}" />
    </Style>

    <Style x:Key="BodyMutedLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeSecondaryText}" />
        <Setter Property="LineHeight" Value="1.45" />
    </Style>

    <Style x:Key="CaptionLabelStyle" TargetType="Label" BasedOn="{StaticResource BodyMutedLabelStyle}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PoemBodyLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SerifFontFamily}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="LineHeight" Value="1.65" />
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
    </Style>

    <Style x:Key="TagLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SansFontSemiBold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSecondaryBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeAccent}" />
    </Style>

    <Style x:Key="OverlineLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SansFontSemiBold}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeAccent}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeAccent}" />
        <Setter Property="TextColor" Value="{DynamicResource ThemeButtonText}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#26000000" Offset="0,8" Radius="20" Opacity="0.18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSecondaryBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource ThemePrimaryText}" />
        <Setter Property="BorderColor" Value="{DynamicResource ThemeBorderDivider}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
</ResourceDictionary>
